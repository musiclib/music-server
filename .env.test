# server settings
CORS_ORIGINS=http://localhost:8100
DATABASE_PATH=":memory:"
JWT_SECRET=a-different-secret-key-for-jwt-sessions
NODE_ENV=test
SERVER_ADDRESS=127.0.0.1
PINNED_SERVER_ADDRESS=127.0.0.1
SERVER_PORT=7100
SWAGGER_ENABLED=true
TZ=UTC

# authentication cert
PUBLIC_KEY_PATH=${PWD}/certs/public.pem
PRIVATE_KEY_PATH=${PWD}/certs/private.pem

# testing library
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin
DEFAULT_ADMIN_ROOT_PATH=${PWD}/test-library/root-1,${PWD}/test-library/root-2
DEFAULT_USER_USERNAME=user
DEFAULT_USER_PASSWORD=user

# music servers
QNAP_MUSICSTATION_ENABLED=true
SYNOLOGY_AUDIOSTATION_ENABLED=true
